#!/usr/bin/env python3
"""Gera abi/c/nexo_syscalls.h a partir de abi/syscall/src/lib.rs (numeros de syscall e codigos
de Status) — os headers C nunca desatualizam em relacao a ABI Rust."""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SRC = (ROOT / "abi" / "syscall" / "src" / "lib.rs").read_text(encoding="utf-8")
out = ["/* GERADO por tools/nexo-cheaders a partir de abi/syscall/src/lib.rs — nao edite. */",
       "#ifndef NEXO_SYSCALLS_H", "#define NEXO_SYSCALLS_H", ""]
for m in re.finditer(r"pub const (SYS_[A-Z0-9_]+): u64 = (\d+);", SRC):
    out.append(f"#define NEXO_{m.group(1)} {m.group(2)}ULL")
out.append("")
enum = re.search(r"pub enum Status \{(.*?)\n\}", SRC, re.S)
for m in re.finditer(r"([A-Za-z]+) = (\d+|u64::MAX),", enum.group(1)):
    v = m.group(2).replace("u64::MAX", "0xffffffffffffffff")
    out.append(f"#define NEXO_STATUS_{m.group(1).upper()} {v}ULL")
out += ["", "#endif /* NEXO_SYSCALLS_H */", ""]
(ROOT / "abi" / "c" / "nexo_syscalls.h").write_text("\n".join(out), encoding="utf-8")
print(f"nexo-cheaders: {sum(1 for l in out if l.startswith('#define'))} definicoes")
