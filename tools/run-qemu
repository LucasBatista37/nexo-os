#!/usr/bin/env python3
"""run-qemu — inicia build/nexo.img no QEMU (q35 + UEFI) com serial no terminal.

Uso: tools/run-qemu [--image build/nexo.img] [--test] [--timeout 120] [--log arquivo] [--gdb]
  --test   headless: sem display, encerra via isa-debug-exit, aplica timeout, retorna o codigo do QEMU
  --gdb    expoe gdbstub em :1234 e aguarda (lldb: `gdb-remote 1234`; gdb: `target remote :1234`)
"""
import argparse
import os
import random
import re
import selectors
import shutil
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from nexo_common import BUILD, die, find_ovmf, log, require

SUCCESS_EXIT = 33  # (0x10 << 1) | 1


def ovmf_vars_for(code: Path):
    """Arquivo de variáveis correspondente ao firmware CODE, se existir."""
    name = code.name
    candidates = [
        name.replace("CODE", "VARS"),
        name.replace("x86_64-code", "i386-vars"),
        "OVMF_VARS_4M.fd" if "4M" in name else "OVMF_VARS.fd",
    ]
    for c in candidates:
        p = code.parent / c
        if p != code and p.is_file():
            return p
    return None
FAILURE_EXIT = 35  # (0x11 << 1) | 1


def qemu_cmd(image: Path, test: bool, gdb: bool, extra: list, smp: int = 4, disk=None, console_socket=None) -> list:
    qemu = require("qemu-system-x86_64", "Instale QEMU (macOS: brew install qemu; Debian: apt install qemu-system-x86)")
    ovmf = find_ovmf()
    cmd = [
        qemu, "-machine", "q35", "-cpu", "qemu64", "-m", "512M", "-smp", str(smp),
        "-drive", f"if=pflash,format=raw,readonly=on,file={ovmf}",
    ]
    # NVRAM gravável (cópia por execução): OVMF de distribuições Linux exige.
    vars_src = ovmf_vars_for(ovmf)
    if vars_src is not None:
        vars_img = BUILD / "efivars.fd"
        shutil.copy2(vars_src, vars_img)
        cmd += ["-drive", f"if=pflash,format=raw,file={vars_img}"]
    cmd += [
        "-drive", f"format=raw,file={image}",
        "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04",
    ]
    if disk is not None:
        cmd += [
            "-drive", f"if=none,id=nexodata,format=raw,file={disk}",
            "-device", "virtio-blk-pci,drive=nexodata,serial=nexodata,disable-legacy=on",
            "-device", "virtio-rng-pci,disable-legacy=on",
            # A imagem de boot (GPT + ESP FAT32) tambem como virtio-blk somente leitura, depois
            # dos outros (BDF maior): o `espfs` le o ESP por ela; `file.locking=off` porque o
            # mesmo arquivo ja esta aberto como disco de boot (AHCI).
            "-drive", f"if=none,id=nexoboot,format=raw,readonly=on,file.locking=off,file={image}",
            "-device", "virtio-blk-pci,drive=nexoboot,serial=nexoboot,disable-legacy=on",
        ]
    if console_socket is not None:
        cmd += [
            "-device", "virtio-serial-pci,disable-legacy=on",
            "-chardev", f"socket,id=nexocon,path={console_socket},server=on,wait=off",
            "-device", "virtconsole,chardev=nexocon",
        ]
    cmd += [
        "-no-reboot",
        "-serial", "stdio",
        "-monitor", "none",
    ]
    if test:
        cmd += ["-display", "none"]
    if gdb:
        cmd += ["-s", "-S"]
    return cmd + extra


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--image", default=str(BUILD / "nexo.img"))
    ap.add_argument("--test", action="store_true")
    ap.add_argument("--timeout", type=float, default=120.0)
    ap.add_argument("--log", default=None, help="grava a saida serial neste arquivo")
    ap.add_argument("--gdb", action="store_true")
    ap.add_argument("--disk", default=str(BUILD / "data.img"),
                    help="disco de dados virtio-blk (raw; criado com 16 MiB se nao existir)")
    ap.add_argument("--no-disk", action="store_true", help="nao anexa o disco de dados")
    ap.add_argument("--console-socket", default=None, metavar="PATH",
                    help="anexa uma virtio-console ligada a um socket UNIX (servidor) neste caminho")
    ap.add_argument("--kill-on", default=None, metavar="REGEX",
                    help="mata o QEMU (SIGKILL, como um corte de energia) assim que a saida serial casar; sai com 99")
    ap.add_argument("--kill-delay-ms", type=int, default=0,
                    help="com --kill-on: espera um atraso aleatorio de 0..N ms antes de matar (para cair no meio das escritas)")
    ap.add_argument("--smp", type=int, default=int(os.environ.get("NEXO_SMP", "4")), help="numero de CPUs (padrao 4)")
    ap.add_argument("extra", nargs="*", help="argumentos extras para o QEMU (apos --)")
    a = ap.parse_args()
    image = Path(a.image)
    if not image.exists():
        die(f"imagem nao encontrada: {image} (rode tools/build-image)")
    disk = None
    if not a.no_disk:
        disk = Path(a.disk)
        if not disk.exists():
            disk.parent.mkdir(parents=True, exist_ok=True)
            with open(disk, "wb") as f:
                f.truncate(16 * 1024 * 1024)
    cmd = qemu_cmd(image, a.test, a.gdb, a.extra, a.smp, disk, a.console_socket)
    log("$ " + " ".join(cmd))
    if not a.test and not a.log:
        return subprocess.call(cmd)

    logf = open(a.log, "wb") if a.log else None
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
    start = time.time()
    sel = selectors.DefaultSelector()
    sel.register(proc.stdout, selectors.EVENT_READ)
    timed_out = False
    killed = False
    kill_re = re.compile(a.kill_on.encode()) if a.kill_on else None
    tail = b""

    def emit(chunk: bytes) -> None:
        nonlocal tail
        sys.stdout.buffer.write(chunk)
        sys.stdout.flush()
        if logf:
            logf.write(chunk)
        if kill_re:
            tail = (tail + chunk)[-8192:]

    while True:
        if proc.poll() is not None:
            rest = proc.stdout.read()
            if rest:
                emit(rest)
            break
        if time.time() - start > a.timeout:
            timed_out = True
            proc.kill()
            break
        for _ in sel.select(timeout=0.2):
            chunk = os.read(proc.stdout.fileno(), 65536)
            if chunk:
                emit(chunk)
        if kill_re and kill_re.search(tail):
            delay = random.randint(0, a.kill_delay_ms) if a.kill_delay_ms > 0 else 0
            time.sleep(delay / 1000.0)
            killed = True
            proc.kill()
            emit(b"\n[nexo] corte de energia simulado: QEMU morto (SIGKILL) " + str(delay).encode()
                 + b" ms apos casar /" + a.kill_on.encode() + b"/\n")
            break
    if logf:
        logf.close()
    if killed:
        proc.wait()
        return 99
    if timed_out:
        log(f"TIMEOUT apos {a.timeout:.0f}s")
        return 124
    log(f"QEMU encerrou com codigo {proc.returncode} "
        f"({'sucesso' if proc.returncode == SUCCESS_EXIT else 'falha' if proc.returncode == FAILURE_EXIT else 'inesperado'})")
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())
