#!/usr/bin/env python3
"""test-recovery — prova o ambiente de recuperação independente (ADR-0010).

Duas variantes, cada uma numa CÓPIA da imagem (estado resetado ao canônico):

  1. kernels de A e B corrompidos (ELFs inválidos): o loader reprova os dois slots e cai no
     `\\nexo\\recovery\\` — o sistema de recuperação arranca e a suíte inteira passa nele;
  2. estado inelegível (ambos sem sucesso e sem tentativas — updates que esgotaram): o loader
     nem tenta os slots e vai direto ao recovery.

O recovery é uma cópia do sistema que nenhuma atualização toca (só o build a grava): a máquina
sempre arranca algo.

Uso: tools/test-recovery [--timeout 420]
"""
import argparse
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build"
ESP = "@@{}".format(2048 * 512)


def pack_state(a, b, last):
    body = struct.pack("<8sI4B4B4B", b"NEXOSLAB", 1, *a, 0, *b, 0, last, 0, 0, 0)
    return (body + struct.pack("<I", zlib.crc32(body))).ljust(512, b"\0")


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--timeout", type=int, default=420)
    args = ap.parse_args()

    src = BUILD / "nexo.img"
    if not src.exists():
        print("test-recovery: build/nexo.img nao existe (rode tools/build-image)", file=sys.stderr)
        return 2
    mcopy = shutil.which("mcopy")
    if not mcopy:
        print("test-recovery: mtools ausente", file=sys.stderr)
        return 2

    results = []
    for variant, (state, corrupt) in {
        "kernels-invalidos": (pack_state((2, 3, 1), (1, 3, 1), 0), True),
        "estado-inelegivel": (pack_state((2, 0, 0), (1, 0, 0), 0), False),
    }.items():
        img = BUILD / f"rec-{variant}.img"
        shutil.copy2(src, img)
        st = BUILD / "rec-slots.bin"
        st.write_bytes(state)
        subprocess.run([mcopy, "-i", f"{img}{ESP}", "-o", str(st), "::/nexo/slots.bin"],
                       check=True)
        if corrupt:
            lixo = BUILD / "rec-lixo.bin"
            lixo.write_bytes(b"\xff" * 4096)
            for dst in ("::/nexo/a/kernel.elf", "::/nexo/b/kernel.elf"):
                subprocess.run([mcopy, "-i", f"{img}{ESP}", "-o", str(lixo), dst], check=True)
        log = BUILD / "logs" / f"recovery-{variant}.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run([str(ROOT / "tools" / "run-qemu"), "--image", str(img), "--test",
                        "--timeout", str(args.timeout), "--log", str(log)])
        text = log.read_text(errors="replace") if log.exists() else ""
        ok = ("RECUPERACAO: arrancando pelo ambiente de recuperacao" in text
              and "[RESULT] PASS" in text)
        results.append((variant, ok))
        print(f"test-recovery: {variant} = {'ok' if ok else 'FALHOU'} (log {log})")

    return 0 if all(ok for _, ok in results) else 1


if __name__ == "__main__":
    sys.exit(main())
