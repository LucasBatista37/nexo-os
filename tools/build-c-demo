#!/bin/sh
# Compila examples/c/hello.c (freestanding, sem libc) em build/hello-c.elf usando clang +
# rust-lld — o mesmo layout dos servicos (estatico, no-PIE, entry _start). Sem toolchain,
# sai 0 com aviso: o demo e opcional e os testes que dependem dele sao guardados.
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/build/hello-c.elf"
command -v clang >/dev/null 2>&1 || { echo "[c-demo] pulado: sem clang"; exit 0; }
SYSROOT="$(rustc --print sysroot 2>/dev/null)" || { echo "[c-demo] pulado: sem rustc"; exit 0; }
LLD="$(find "$SYSROOT" -name rust-lld -type f 2>/dev/null | head -1)"
[ -n "$LLD" ] || { echo "[c-demo] pulado: sem rust-lld"; exit 0; }
mkdir -p "$ROOT/build"
"$ROOT/tools/nexo-cheaders" >/dev/null
CFLAGS="--target=x86_64-unknown-none-elf -ffreestanding -fno-stack-protector -fno-builtin \
        -mno-red-zone -mno-sse -mno-sse2 -mno-mmx -mno-avx -msoft-float \
        -fomit-frame-pointer -O2"
clang $CFLAGS -c "$ROOT/examples/c/hello.c" -o "$ROOT/build/hello-c.o"
clang $CFLAGS -c "$ROOT/sdk/libc/src/string.c" -o "$ROOT/build/libc-string.o"
clang $CFLAGS -c "$ROOT/sdk/libc/src/stdio.c" -o "$ROOT/build/libc-stdio.o"
clang $CFLAGS -c "$ROOT/sdk/libc/src/stdlib.c" -o "$ROOT/build/libc-stdlib.o"
clang $CFLAGS -c "$ROOT/sdk/libc/src/fd.c" -o "$ROOT/build/libc-fd.o"
"$LLD" -flavor gnu --no-pie -e _start -o "$OUT" "$ROOT/build/hello-c.o" \
       "$ROOT/build/libc-string.o" "$ROOT/build/libc-stdio.o" "$ROOT/build/libc-stdlib.o" \
       "$ROOT/build/libc-fd.o"
echo "[c-demo] $OUT ($(wc -c < "$OUT" | tr -d ' ') bytes)"
# ssetest: compilado COM SSE (o kernel liga OSFXSR e salva XMM por thread) — prova FPU/SIMD
# de usuario e o isolamento do estado entre processos.
CFLAGS_SSE="--target=x86_64-unknown-none-elf -ffreestanding -fno-stack-protector -fno-builtin \
        -mno-red-zone -fomit-frame-pointer -O2"
clang $CFLAGS_SSE -c "$ROOT/examples/c/ssetest.c" -o "$ROOT/build/sse-c.o"
"$LLD" -flavor gnu --no-pie -e _start -o "$ROOT/build/sse-c.elf" "$ROOT/build/sse-c.o"
clang $CFLAGS -c "$ROOT/sdk/libc/src/crt0.c" -o "$ROOT/build/libc-crt0.o"
clang $CFLAGS -c "$ROOT/examples/c/wc.c" -o "$ROOT/build/wc-c.o"
"$LLD" -flavor gnu --no-pie -e _start -o "$ROOT/build/wc-c.elf" "$ROOT/build/wc-c.o" \
       "$ROOT/build/libc-crt0.o" "$ROOT/build/libc-string.o" "$ROOT/build/libc-stdio.o" \
       "$ROOT/build/libc-stdlib.o" "$ROOT/build/libc-fd.o"
echo "[c-demo] $ROOT/build/wc-c.elf ($(wc -c < "$ROOT/build/wc-c.elf" | tr -d ' ') bytes)"
for UTIL in cat ls cp rm mv echo head mkdir sh grep sort; do
  clang $CFLAGS -c "$ROOT/examples/c/$UTIL.c" -o "$ROOT/build/$UTIL-c.o"
  "$LLD" -flavor gnu --no-pie -e _start -o "$ROOT/build/$UTIL-c.elf" "$ROOT/build/$UTIL-c.o" \
         "$ROOT/build/libc-crt0.o" "$ROOT/build/libc-string.o" "$ROOT/build/libc-stdio.o" \
         "$ROOT/build/libc-stdlib.o" "$ROOT/build/libc-fd.o"
  echo "[c-demo] $ROOT/build/$UTIL-c.elf ($(wc -c < "$ROOT/build/$UTIL-c.elf" | tr -d ' ') bytes)"
done
clang $CFLAGS -c "$ROOT/examples/c/fstest.c" -o "$ROOT/build/fs-c.o"
"$LLD" -flavor gnu --no-pie -e _start -o "$ROOT/build/fs-c.elf" "$ROOT/build/fs-c.o" \
       "$ROOT/build/libc-string.o" "$ROOT/build/libc-stdio.o" "$ROOT/build/libc-fd.o"
echo "[c-demo] $ROOT/build/fs-c.elf ($(wc -c < "$ROOT/build/fs-c.elf" | tr -d ' ') bytes)"
echo "[c-demo] $ROOT/build/sse-c.elf ($(wc -c < "$ROOT/build/sse-c.elf" | tr -d ' ') bytes)"
# hello-cpp: primeiro processo C++ (clang++ freestanding, sem exceptions/RTTI; ctors via
# .init_array — o lld define os limites; new/delete sobre o heap da nexo-libc)
if command -v clang++ >/dev/null 2>&1; then
  CXXFLAGS="$CFLAGS -fno-exceptions -fno-rtti"
  clang++ $CXXFLAGS -c "$ROOT/examples/c/hello-cpp.cpp" -o "$ROOT/build/hello-cpp.o"
  clang++ $CXXFLAGS -c "$ROOT/sdk/libc/src/cxx.cpp" -o "$ROOT/build/libc-cxx.o"
  "$LLD" -flavor gnu --no-pie -e _start -o "$ROOT/build/hello-cpp.elf" \
         "$ROOT/build/hello-cpp.o" "$ROOT/build/libc-cxx.o" \
         "$ROOT/build/libc-string.o" "$ROOT/build/libc-stdio.o" "$ROOT/build/libc-stdlib.o"
  echo "[c-demo] $ROOT/build/hello-cpp.elf ($(wc -c < "$ROOT/build/hello-cpp.elf" | tr -d ' ') bytes)"
else
  echo "[c-demo] hello-cpp pulado: sem clang++"
fi
