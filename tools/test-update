#!/usr/bin/env python3
"""test-update — prova a atualização atômica A/B entre boots (ADR-0010).

Numa CÓPIA da imagem (estado resetado ao canônico: A ativo confirmado, B reserva):

  boot 1: a suíte roda `user_update` — o upd copia kernel+initrd de A para B por dentro do FAT
          (reescrita à prova de cortes) e marca B pendente (prioridade 3); a suíte passa e o
          health check confirma o slot corrente (A), sem tocar no update pendente em voo;
  boot 2: o loader escolhe B (pendente, prioridade maior), desconta uma tentativa — o sistema
          sobe POR B, a suíte inteira passa e o health check confirma B, que vira o corrente
          (A é rebaixado; e a suíte do boot 2 já aplica a próxima alternância, B→A).

No fim, o estado relido da imagem tem B confirmado prioridade 2 (corrente) e A pendente da
alternância seguinte — o ciclo de vida completo da atualização, provado entre boots reais.

Uso: tools/test-update [--timeout 420]
"""
import argparse
import shutil
import struct
import subprocess
import sys
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BUILD = ROOT / "build"
ESP = "@@{}".format(2048 * 512)


def pack_state(a, b, last):
    body = struct.pack("<8sI4B4B4B", b"NEXOSLAB", 1, *a, 0, *b, 0, last, 0, 0, 0)
    return (body + struct.pack("<I", zlib.crc32(body))).ljust(512, b"\0")


def unpack_state(raw):
    magic, ver = struct.unpack_from("<8sI", raw)
    assert magic == b"NEXOSLAB" and ver == 1, "slots.bin invalido"
    assert struct.unpack_from("<I", raw, 24)[0] == zlib.crc32(raw[:24]), "CRC invalido"
    return (struct.unpack_from("<3B", raw, 12), struct.unpack_from("<3B", raw, 16), raw[20])


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--timeout", type=int, default=420)
    args = ap.parse_args()

    src = BUILD / "nexo.img"
    if not src.exists():
        print("test-update: build/nexo.img nao existe (rode tools/build-image)", file=sys.stderr)
        return 2
    mcopy = shutil.which("mcopy")
    if not mcopy:
        print("test-update: mtools ausente", file=sys.stderr)
        return 2
    img = BUILD / "up-test.img"
    shutil.copy2(src, img)

    # estado canônico: A ativo confirmado (p2), B reserva confirmada (p1)
    state = BUILD / "up-slots.bin"
    state.write_bytes(pack_state((2, 3, 1), (1, 3, 1), 0))
    subprocess.run([mcopy, "-i", f"{img}{ESP}", "-o", str(state), "::/nexo/slots.bin"], check=True)

    logs = []
    for i in (1, 2):
        log = BUILD / "logs" / f"update-{i}.log"
        log.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run([str(ROOT / "tools" / "run-qemu"), "--image", str(img), "--test",
                        "--timeout", str(args.timeout), "--log", str(log)])
        logs.append(log.read_text(errors="replace") if log.exists() else "")

    boot1 = ("atualizacao aplicada no slot B" in logs[0] and "[RESULT] PASS" in logs[0])
    boot2 = ("slot B (pendente, prioridade 3, tentativas 2)" in logs[1]
             and "upd: slot B confirmado (health check pos-boot)" in logs[1]
             and "[RESULT] PASS" in logs[1])

    subprocess.run([mcopy, "-i", f"{img}{ESP}", "-n", "-o", "::/nexo/slots.bin", str(state)],
                   check=True)
    a, b, last = unpack_state(state.read_bytes())
    # B virou o corrente (confirmado, p2); A carrega a alternância seguinte (pendente, p3)
    persisted = b == (2, 3, 1) and a == (3, 3, 0) and last == 1

    pstate = "ok" if persisted else f"FALHOU A={a} B={b} last={last}"
    print(f"test-update: boot1(aplicou em B)={'ok' if boot1 else 'FALHOU'} "
          f"boot2(arrancou por B pendente e confirmou)={'ok' if boot2 else 'FALHOU'} "
          f"estado-persistido={pstate}")
    return 0 if boot1 and boot2 and persisted else 1


if __name__ == "__main__":
    sys.exit(main())
