def run_shell_scenario(timeout: float) -> bool:
    """Sobe o QEMU com virtio-console em socket UNIX, conversa com o shell e sai."""
    import socket

    image = BUILD / "nexo-shell.img"
    run([sys.executable, ROOT / "tools" / "build-image", "--no-build", "--cmdline", "selftest=0 shell=1 exit",
         "--out", image], stdout=subprocess.DEVNULL)
    disk = BUILD / "nexo-shell-data.img"
    sock_path = BUILD / "nexo-shell.sock"
    if sock_path.exists():
        sock_path.unlink()
    logfile = BUILD / "logs" / "shell.log"
    logfile.parent.mkdir(parents=True, exist_ok=True)
    log(f"=== cenario 'shell' (interativo pela console VirtIO) ===")
    proc = subprocess.Popen([sys.executable, ROOT / "tools" / "run-qemu", "--test", "--image", image,
                             "--disk", disk, "--console-socket", sock_path,
                             "--timeout", str(timeout), "--log", logfile],
                            stdout=subprocess.DEVNULL, stderr=subprocess.STDOUT)
    ok = True
    transcript = b""
    try:
        sk = None
        deadline = time.time() + 60
        while time.time() < deadline:
            if sock_path.exists():
                try:
                    sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    sk.connect(str(sock_path))
                    break
                except OSError:
                    sk = None
            time.sleep(0.3)
        if sk is None:
            log("FALHA: socket da console nao apareceu")
            return False
        sk.settimeout(1.0)

        def read_until(pattern: str, limit: float) -> bool:
            nonlocal transcript
            rx = re.compile(pattern.encode())
            end = time.time() + limit
            start = len(transcript)
            while time.time() < end:
                try:
                    chunk = sk.recv(4096)
                except socket.timeout:
                    chunk = b""
                if chunk:
                    transcript += chunk
                if rx.search(transcript[start:]):
                    return True
            return False

        if not read_until(r"shell de diagnostico", 60):
            log("FALHA: prompt inicial nao chegou")
            ok = False
        for cmd, expect in SHELL_SCRIPT if ok else []:
            sk.sendall(cmd.encode() + b"\n")
            if not read_until(expect, 20):
                log(f"FALHA: comando {cmd!r} sem resposta /{expect}/")
                ok = False
                break
        if ok:
            sk.sendall(b"sair\n")
            if not read_until(r"ate mais", 20):
                log("FALHA: 'sair' sem despedida")
                ok = False
        sk.close()
    finally:
        rc = proc.wait(timeout=timeout + 60)
    text = logfile.read_bytes().decode("utf-8", errors="replace")
    (BUILD / "logs" / "shell-transcript.log").write_bytes(transcript)
    if rc != 33:
        log(f"FALHA: codigo de saida {rc}, esperado 33")
        ok = False
    for pat in [r"\[SHELL\] shell de diagnostico ativo na console VirtIO",
                r"consoledev: virtio-console bdf 0x[0-9a-f]+ pronto \(rx \d+, tx \d+, MSI-X\)",
                r"\[SHELL\] shell terminou com 0",
                r"NEXO: boot completo"]:
        if not re.search(pat, text):
            log(f"FALHA: marcador ausente: /{pat}/")
            ok = False
    for pat in [r"KERNEL PANIC", r"EXCEPTION"]:
        if re.search(pat, text):
            log(f"FALHA: marcador proibido presente: /{pat}/")
            ok = False
    log(f"=== cenario 'shell': {'PASS' if ok else 'FAIL'} (log: {logfile}) ===")
    return ok


def qmp_send_keys(sock_path, keys) -> bool:
    """Conecta ao QMP e injeta teclas (uma por vez, com intervalo)."""
    import json
    import socket

    deadline = time.time() + 60
    sk = None
    last_err = "socket nunca apareceu"
    while time.time() < deadline:
        try:
            sk = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sk.connect(str(sock_path))
            break
        except OSError as e:
            last_err = str(e)
            sk = None
        time.sleep(0.3)
    if sk is None:
        log(f"qmp: {last_err}")
        return False
    sk.settimeout(10.0)
    f = sk.makefile("rwb")
    f.readline()  # saudacao
    def cmd(obj):
        f.write(json.dumps(obj).encode() + b"\n")
        f.flush()
        return f.readline()
    cmd({"execute": "qmp_capabilities"})
    for k in keys:
        cmd({"execute": "send-key", "arguments": {"keys": [{"type": "qcode", "data": k}]}})
        time.sleep(0.3)
    sk.close()
    return True


def run_input_scenario(timeout: float) -> bool:
    """Teclado virtio: o host injeta teclas por QMP e o driver de usuario as recebe."""
    image = BUILD / "nexo-input.img"
    run([sys.executable, ROOT / "tools" / "build-image", "--no-build", "--cmdline", "selftest=0 input-test=1 exit",
         "--out", image], stdout=subprocess.DEVNULL)
    qmp_path = BUILD / "nexo-input.qmp"
    if qmp_path.exists():
        qmp_path.unlink()
    logfile = BUILD / "logs" / "input.log"
    logfile.parent.mkdir(parents=True, exist_ok=True)
    if logfile.exists():
        logfile.unlink()
    log("=== cenario 'input' (teclas via QMP) ===")
    runner_log = open(BUILD / "logs" / "input-runner.log", "wb")
    proc = subprocess.Popen([sys.executable, ROOT / "tools" / "run-qemu", "--test", "--image", image,
                             "--disk", BUILD / "nexo-input-data.img", "--input-keyboard",
                             "--qmp-socket", qmp_path, "--timeout", str(timeout), "--log", logfile],
                            stdout=runner_log, stderr=subprocess.STDOUT)
    ok = True
    # espera o kernel sinalizar que o driver esta pronto antes de injetar
    deadline = time.time() + 90
    while time.time() < deadline:
        if logfile.exists() and b"[INPUT] aguardando teclas" in logfile.read_bytes():
            break
        time.sleep(0.5)
    time.sleep(1.0)
    if not qmp_send_keys(qmp_path, ["a", "b", "ret"]):
        log("FALHA: socket QMP nao respondeu")
        ok = False
    rc = proc.wait(timeout=timeout + 60)
    text = logfile.read_bytes().decode("utf-8", errors="replace")
    if rc != 33:
        log(f"FALHA: codigo de saida {rc}, esperado 33")
        ok = False
    for pat in [r"inputdev: virtio-input bdf 0x[0-9a-f]+ pronto \(fila \d+, \d+ buffers, MSI-X\)",
                r"utest: input: tecla code=30",
                r"utest: input: tecla code=48",
                r"utest: input: tecla code=28",
                r"utest: input ok \(3 teclas, ultima code=28\)",
                r"\[INPUT\] teste de entrada terminou com 0",
                r"NEXO: boot completo"]:
        if not re.search(pat, text):
            log(f"FALHA: marcador ausente: /{pat}/")
            ok = False
    for pat in [r"KERNEL PANIC", r"EXCEPTION", r"inputdev: falha"]:
        if re.search(pat, text):
            log(f"FALHA: marcador proibido presente: /{pat}/")
            ok = False
    log(f"=== cenario 'input': {'PASS' if ok else 'FAIL'} (log: {logfile}) ===")
    return ok


def run_net_scenario(timeout: float) -> bool:
    """virtio-net + slirp: DHCP, ARP, ping, DNS e TCP com um servidor no host."""
    import socket
    import threading

    # servidor TCP no host: le ate \n e responde "nexo-tcp-ok" (o guest chega nele por 10.0.2.2)
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("127.0.0.1", 0))
    srv.listen(1)
    tcp_port = srv.getsockname()[1]

    def serve():
        # atende quantas conexoes chegarem (fase 1: TCP cru; fase 2: netd)
        srv.settimeout(timeout)
        while True:
            try:
                conn, _ = srv.accept()
            except OSError:
                return
            try:
                conn.settimeout(30)
                data = b""
                while b"\n" not in data:
                    chunk = conn.recv(256)
                    if not chunk:
                        break
                    data += chunk
                conn.sendall(b"nexo-tcp-ok")
                try:
                    conn.recv(64)
                except OSError:
                    pass
                conn.close()
            except OSError:
                pass

    th = threading.Thread(target=serve, daemon=True)
    th.start()

    # servidor de eco UDP no host: responde "nexo-udp-ok" a qualquer datagrama
    usrv = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    usrv.bind(("127.0.0.1", 0))
    udp_port = usrv.getsockname()[1]

    def userve():
        usrv.settimeout(timeout)
        while True:
            try:
                data, addr = usrv.recvfrom(2048)
            except OSError:
                return
            if data:
                try:
                    usrv.sendto(b"nexo-udp-ok", addr)
                except OSError:
                    return

    uth = threading.Thread(target=userve, daemon=True)
    uth.start()

    # porta livre para o hostfwd (conexao de entrada no convidado)
    probe = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    probe.bind(("127.0.0.1", 0))
    fwd_port = probe.getsockname()[1]
    probe.close()

    def connector():
        # tenta ate o convidado escutar (o utest so escuta depois das fases anteriores)
        deadline = time.time() + timeout
        while time.time() < deadline:
            try:
                c = socket.create_connection(("127.0.0.1", fwd_port), timeout=3)
            except OSError:
                time.sleep(0.5)
                continue
            try:
                c.settimeout(20)
                c.sendall(b"ola do host\n")
                data = b""
                while len(data) < 14:
                    chunk = c.recv(64)
                    if not chunk:
                        break
                    data += chunk
                c.close()
                if data == b"nexo-listen-ok":
                    return
            except OSError:
                try:
                    c.close()
                except OSError:
                    pass
                time.sleep(0.5)

    cth = threading.Thread(target=connector, daemon=True)
    cth.start()

    # servidor HTTP/1.0 minimo: responde 200 com corpo conhecido a qualquer GET
    hsrv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    hsrv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    hsrv.bind(("127.0.0.1", 0))
    hsrv.listen(1)
    http_port = hsrv.getsockname()[1]

    def hserve():
        hsrv.settimeout(timeout)
        while True:
            try:
                conn, _ = hsrv.accept()
            except OSError:
                return
            try:
                conn.settimeout(20)
                data = b""
                while b"\r\n\r\n" not in data:
                    chunk = conn.recv(512)
                    if not chunk:
                        break
                    data += chunk
                body = b"nexo-http-ok\n"
                conn.sendall(b"HTTP/1.0 200 OK\r\nContent-Length: "
                             + str(len(body)).encode() + b"\r\n\r\n" + body)
                conn.close()
            except OSError:
                pass

    hth = threading.Thread(target=hserve, daemon=True)
    hth.start()

    image = BUILD / "nexo-net.img"
    run([sys.executable, ROOT / "tools" / "build-image", "--no-build",
         "--cmdline", f"selftest=0 net-test=1 tcp-port={tcp_port} udp-port={udp_port} http-port={http_port} exit",
         "--out", image], stdout=subprocess.DEVNULL)
    logfile = BUILD / "logs" / "net.log"
    logfile.parent.mkdir(parents=True, exist_ok=True)
    log("=== cenario 'net' (ARP com o slirp) ===")
    rc = subprocess.call([sys.executable, ROOT / "tools" / "run-qemu", "--test", "--image", image,
                          "--disk", BUILD / "nexo-net-data.img", "--net", "--net-hostfwd", str(fwd_port),
                             "--net-dump", BUILD / "logs" / "net.pcap",
                          "--timeout", str(timeout), "--log", logfile])
    text = logfile.read_bytes().decode("utf-8", errors="replace")
    ok = True
    if rc != 33:
        log(f"FALHA: codigo de saida {rc}, esperado 33")
        ok = False
    srv.close()
    usrv.close()
    hsrv.close()
    # verifica no pcap que saiu um ICMPv6 Neighbor Solicitation (proto 58, type 135) do guest
    ns_seen = False
    try:
        import struct
        d = (BUILD / "logs" / "net.pcap").read_bytes()
        off = 24
        while off + 16 <= len(d):
            _, _, incl, _ = struct.unpack_from("<IIII", d, off)
            off += 16
            p = d[off:off + incl]
            off += incl
            if len(p) >= 14 + 40 + 4 and p[12:14] == b"\x86\xdd" and p[14] >> 4 == 6 and p[20] == 58:
                if p[14 + 40] == 135:
                    ns_seen = True
                    break
    except OSError:
        pass
    if not ns_seen:
        log("FALHA: nenhum ICMPv6 Neighbor Solicitation (tipo 135) no pcap")
        ok = False

    for pat in [r"netdev: virtio-net bdf 0x[0-9a-f]+ mac 52:54:00:12:34:56 \(rx \d+, tx \d+, MSI-X\)",
                r"utest: dhcp ok — ip 10\.0\.2\.15 mascara 255\.255\.255\.0 gw 10\.0\.2\.2 dns 10\.0\.2\.3",
                r"utest: net: ARP reply do gateway",
                r"utest: net ok — echo reply de 10\.0\.2\.2 \(ttl=\d+, 9 bytes\)",
                r"utest: dns ok —",
                r"utest: tcp: handshake completo com 10\.0\.2\.2:\d+",
                r"utest: tcp ok — dados recebidos de 10\.0\.2\.2:\d+ \(11 bytes\)",
                r"netd: pronto — ip 10\.0\.2\.15 gw 10\.0\.2\.2 dns 10\.0\.2\.3",
                r"utest: sock info — ip 10\.0\.2\.15 gw 10\.0\.2\.2",
                r"utest: sock dns ok — example\.com = \d+\.\d+\.\d+\.\d+ \(2a consulta do cache\)",
                r"utest: sock udp ok — eco de 10\.0\.2\.2:\d+",
                r"utest: sock tcp ok — conectou, enviou e recebeu por 10\.0\.2\.2:\d+",
                r"utest: sock listen — conexao de entrada de 10\.0\.2\.2:\d+",
                r"utest: sock listen ok — servimos uma conexao de entrada na porta 8080",
                r"utest: posix sockets ok — socket/connect/send/recv/close via BSD sobre nexo.sock",
                r"utest: firewall ok — sessao restrita: TCP permitido, DNS/UDP/porta negados",
                r"utest: http ok — GET /nexo\.txt devolveu 200 e o corpo esperado \(\d+ bytes\)",
                r"\[NET\] fase 2 \(netd\) terminou com 0",
                r"\[NET\] teste de rede terminou com 0",
                r"NEXO: boot completo"]:
        if not re.search(pat, text):
            log(f"FALHA: marcador ausente: /{pat}/")
            ok = False
    for pat in [r"KERNEL PANIC", r"EXCEPTION", r"netdev: falha", r"netd: falha"]:
        if re.search(pat, text):
            log(f"FALHA: marcador proibido presente: /{pat}/")
            ok = False
    log(f"=== cenario 'net': {'PASS' if ok else 'FAIL'} (log: {logfile}) ===")
    return ok


def run_scenario(name: str, timeout: float) -> bool:
    if name == "shell":
        return run_shell_scenario(timeout)
    if name == "input":
        return run_input_scenario(timeout)
    if name == "net":
        return run_net_scenario(timeout)
    sc = SCENARIOS[name]
    logfile = BUILD / "logs" / f"{name}.log"
    logfile.parent.mkdir(parents=True, exist_ok=True)
    images = {}
    for run_no in range(1, sc.get("runs", 1) + 1):
        cmdline = sc.get(f"cmdline_run{run_no}", sc["cmdline"])
        if cmdline not in images:
            image = BUILD / (f"nexo-{name}.img" if run_no == 1 else f"nexo-{name}-{run_no}.img")
            run([sys.executable, ROOT / "tools" / "build-image", "--no-build", "--cmdline", cmdline, "--out", image],
                stdout=subprocess.DEVNULL)
            images[cmdline] = image
    disk = BUILD / f"nexo-{name}-data.img"
    if sc.get("fresh_disk") and disk.exists():
        disk.unlink()
    ok = True
    for run_no in range(1, sc.get("runs", 1) + 1):
        cmdline = sc.get(f"cmdline_run{run_no}", sc["cmdline"])
        image = images[cmdline]
        log(f"=== cenario '{name}' (cmdline: {cmdline!r}, execucao {run_no}) ===")
        run_log = logfile if run_no == 1 else logfile.with_suffix(f".{run_no}.log")
        cmd = [sys.executable, ROOT / "tools" / "run-qemu", "--test", "--image", image,
               "--disk", disk, "--timeout", str(timeout), "--log", run_log]
        kill_on = sc.get(f"kill_on_run{run_no}", sc.get("kill_on") if run_no == 1 else None)
        if kill_on:
            cmd += ["--kill-on", kill_on, "--kill-delay-ms", str(sc.get("kill_delay_ms", 0))]
        rc = subprocess.call(cmd)
        text = run_log.read_bytes().decode("utf-8", errors="replace")
        expected_rc = sc.get(f"exit_code_run{run_no}", sc["exit_code"])
        if rc != expected_rc:
            log(f"FALHA: codigo de saida {rc}, esperado {expected_rc}")
            ok = False
        expect = sc.get(f"expect_run{run_no}", sc["expect"])
        for pat in expect:
            if not re.search(pat, text):
                log(f"FALHA: marcador ausente: /{pat}/")
                ok = False
        for pat in sc["forbid"]:
            if re.search(pat, text):
                log(f"FALHA: marcador proibido presente: /{pat}/")
                ok = False
    for args, pat in sc.get("host_check", []):
        r = subprocess.run([sys.executable, ROOT / "tools" / "nexo-disk", "--offset", "0", disk, *args],
                           capture_output=True, text=True)
        if r.returncode != 0 or not re.search(pat, r.stdout, re.M):
            log(f"FALHA: nexo-disk {' '.join(args)}: rc={r.returncode} saida={r.stdout.strip()!r} {r.stderr.strip()!r} (esperado /{pat}/)")
            ok = False
        else:
            log(f"nexo-disk {' '.join(args)}: ok")
    log(f"=== cenario '{name}': {'PASS' if ok else 'FAIL'} (log: {logfile}) ===")
    return ok


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--scenario", choices=sorted(list(SCENARIOS) + ["shell", "input", "net"]), default=None)
    ap.add_argument("--timeout", type=float, default=120.0)
    ap.add_argument("--no-build", action="store_true", help="nao recompila loader/kernel")
    a = ap.parse_args()
    if not a.no_build:
        run([sys.executable, ROOT / "tools" / "build-image", "--cmdline", "exit"])
    names = [a.scenario] if a.scenario else list(SCENARIOS) + ["shell", "input", "net"]
    results = {n: run_scenario(n, a.timeout) for n in names}
    log("resumo: " + ", ".join(f"{n}={'PASS' if ok else 'FAIL'}" for n, ok in results.items()))
    return 0 if all(results.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
