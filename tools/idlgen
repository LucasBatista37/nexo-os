# Backend C (ADR-0014/Fase 6): headers gerados para clientes C — mesmo fio do
# Rust (NXIP + payload little-endian), encode de pedido + decode de resposta.
C_PROTOS = {"fs", "sock"}
C_SCALARS = {"u8": ("uint8_t", 1), "u16": ("uint16_t", 2), "u32": ("uint32_t", 4),
             "u64": ("uint64_t", 8), "i32": ("int32_t", 4), "i64": ("int64_t", 8)}


def c_put(out, ty, size, expr, off):
    out.append(f"    {{ uint64_t v = (uint64_t)({expr}); size_t i; for (i = 0; i < {size}; i++) out[{off} + i] = (uint8_t)(v >> (8 * i)); }}")


def generate_c(path: pathlib.Path) -> str:
    proto, methods = parse(path.read_text(), path)
    pname, major, minor = proto
    full = f"nexo.{pname}"
    up = pname.upper()
    o = []
    o.append(f"/* nexo_proto_{pname}.h — protocolo tipado `{full}` v{major}.{minor} em C.")
    o.append(" * GERADO por tools/idlgen do idl/%s.idl — nao editar. Fio identico ao Rust:" % pname)
    o.append(" * cabecalho NXIP de 24 bytes + payload little-endian (bytes<N>: u32 len + dados).")
    o.append(" * Nesta rodada: encode de PEDIDO + decode de RESPOSTA (clientes C); handles nao")
    o.append(" * ocupam payload — viajam no vetor de handles de nexo_channel_send/recv. */")
    o.append(f"#ifndef NEXO_PROTO_{up}_H")
    o.append(f"#define NEXO_PROTO_{up}_H")
    o.append("")
    o.append("#include <stdint.h>")
    o.append("#include <stddef.h>")
    o.append("")
    o.append(f"#define NEXO_{up}_PROTOCOL_ID 0x{fnv1a(full.encode()):08x}u")
    o.append(f"#define NEXO_{up}_VMAJOR {major}")
    o.append(f"#define NEXO_{up}_VMINOR {minor}")
    o.append("")
    for m in methods:
        if "event" in m:
            continue
        mn = m["name"]
        # structs
        for sec, suf in (("request", "req"), ("response", "resp")):
            o.append(f"typedef struct {{")
            fields = m[sec]
            if not fields:
                o.append("    uint8_t _vazio; /* sem campos */")
            for f in fields:
                if f["type"] == "handle":
                    o.append(f"    uint32_t {f['name']}; /* handle: viaja no vetor, nao no payload */")
                elif f["max"] is not None:
                    o.append(f"    uint8_t {f['name']}[{f['max']}];")
                    o.append(f"    uint32_t {f['name']}_len;")
                else:
                    o.append(f"    {C_SCALARS[f['type']][0]} {f['name']};")
            o.append(f"}} nexo_{pname}_{mn}_{suf};")
            o.append("")
        # encode do pedido
        req = [f for f in m["request"] if f["type"] != "handle"]
        o.append(f"/* Codifica o pedido `{mn}` (metodo {m['id']}); devolve o tamanho ou -1. */")
        o.append(f"static inline int nexo_{pname}_{mn}_req_encode(uint8_t *out, size_t cap, const nexo_{pname}_{mn}_req *m) {{")
        o.append("    size_t o = 24;")
        if not req:
            o.append("    (void)m;")
        for f in req:
            if f["max"] is not None:
                o.append(f"    if (m->{f['name']}_len > {f['max']} || o + 4 + m->{f['name']}_len > cap) return -1;")
                o.append(f"    {{ uint32_t l = m->{f['name']}_len; size_t i; for (i = 0; i < 4; i++) out[o + i] = (uint8_t)(l >> (8 * i)); }}")
                o.append(f"    {{ size_t i; for (i = 0; i < m->{f['name']}_len; i++) out[o + 4 + i] = m->{f['name']}[i]; }}")
                o.append(f"    o += 4 + m->{f['name']}_len;")
            else:
                sz = C_SCALARS[f["type"]][1]
                o.append(f"    if (o + {sz} > cap) return -1;")
                o.append(f"    {{ uint64_t v = (uint64_t)m->{f['name']}; size_t i; for (i = 0; i < {sz}; i++) out[o + i] = (uint8_t)(v >> (8 * i)); }}")
                o.append(f"    o += {sz};")
        o.append("    if (cap < 24) return -1;")
        o.append("    /* magic NXIP: u32 0x4e584950 em little-endian no fio */")
        o.append("    out[0] = 0x50; out[1] = 0x49; out[2] = 0x58; out[3] = 0x4e;")
        o.append(f"    {{ uint32_t v = NEXO_{up}_PROTOCOL_ID; size_t i; for (i = 0; i < 4; i++) out[4 + i] = (uint8_t)(v >> (8 * i)); }}")
        o.append(f"    out[8] = (uint8_t)NEXO_{up}_VMAJOR; out[9] = (uint8_t)(NEXO_{up}_VMAJOR >> 8);")
        o.append(f"    out[10] = (uint8_t)NEXO_{up}_VMINOR; out[11] = (uint8_t)(NEXO_{up}_VMINOR >> 8);")
        o.append(f"    {{ uint32_t v = {m['id']}; size_t i; for (i = 0; i < 4; i++) out[12 + i] = (uint8_t)(v >> (8 * i)); }}")
        o.append("    out[16] = out[17] = out[18] = out[19] = 0; /* flags: pedido */")
        o.append("    { uint32_t v = (uint32_t)(o - 24); size_t i; for (i = 0; i < 4; i++) out[20 + i] = (uint8_t)(v >> (8 * i)); }")
        o.append("    return (int)o;")
        o.append("}")
        o.append("")
        # decode da resposta
        resp = m["response"]
        payload = [f for f in resp if f["type"] != "handle"]
        o.append(f"/* Decodifica a resposta de `{mn}`: 0 = ok; >0 = erro remoto; -1 = malformada. */")
        o.append(f"static inline int nexo_{pname}_{mn}_resp_decode(const uint8_t *b, size_t len, nexo_{pname}_{mn}_resp *m) {{")
        o.append("    if (len < 24 || b[0] != 0x50 || b[1] != 0x49 || b[2] != 0x58 || b[3] != 0x4e) return -1;")
        o.append("    { uint32_t fl = (uint32_t)b[16] | ((uint32_t)b[17] << 8) | ((uint32_t)b[18] << 16) | ((uint32_t)b[19] << 24);")
        o.append("      if (fl & 2u) { if (len < 28) return -1;")
        o.append("        return (int)((uint32_t)b[24] | ((uint32_t)b[25] << 8) | ((uint32_t)b[26] << 16) | ((uint32_t)b[27] << 24)); } }")
        o.append("    { size_t o = 24;")
        if not payload:
            o.append("      (void)o; (void)m;")
        for f in resp:
            if f["type"] == "handle":
                o.append(f"      m->{f['name']} = 0; /* handle: chega no vetor de handles do recv */")
                continue
            if f["max"] is not None:
                o.append("      { uint32_t l; size_t i;")
                o.append("        if (o + 4 > len) return -1;")
                o.append("        l = (uint32_t)b[o] | ((uint32_t)b[o + 1] << 8) | ((uint32_t)b[o + 2] << 16) | ((uint32_t)b[o + 3] << 24);")
                o.append(f"        if (l > {f['max']} || o + 4 + l > len) return -1;")
                o.append(f"        for (i = 0; i < l; i++) m->{f['name']}[i] = b[o + 4 + i];")
                o.append(f"        m->{f['name']}_len = l; o += 4 + l; }}")
            else:
                sz = C_SCALARS[f["type"]][1]
                cty = C_SCALARS[f["type"]][0]
                if f["default"] is not None:
                    o.append(f"      if (o + {sz} <= len) {{ uint64_t v = 0; size_t i; for (i = 0; i < {sz}; i++) v |= (uint64_t)b[o + i] << (8 * i); m->{f['name']} = ({cty})v; o += {sz}; }} else m->{f['name']} = ({cty}){f['default']};")
                else:
                    o.append(f"      {{ uint64_t v = 0; size_t i; if (o + {sz} > len) return -1; for (i = 0; i < {sz}; i++) v |= (uint64_t)b[o + i] << (8 * i); m->{f['name']} = ({cty})v; o += {sz}; }}")
        o.append("    }")
        o.append("    return 0;")
        o.append("}")
        o.append("")
    o.append(f"#endif /* NEXO_PROTO_{up}_H */")
    return "\n".join(o) + "\n"


def main() -> int:
    gen_dir = ROOT / "abi" / "proto" / "src" / "generated"
    gen_dir.mkdir(parents=True, exist_ok=True)
    c_dir = ROOT / "abi" / "c" / "proto"
    c_dir.mkdir(parents=True, exist_ok=True)
    mods = []
    for idl in sorted((ROOT / "idl").glob("*.idl")):
        name = idl.stem
        (gen_dir / f"{name}.rs").write_text(generate(idl))
        mods.append(name)
        print(f"[idl] {idl.name} -> abi/proto/src/generated/{name}.rs")
        if name in C_PROTOS:
            (c_dir / f"{name}.h").write_text(generate_c(idl))
            print(f"[idl] {idl.name} -> abi/c/proto/{name}.h")
    lines = ["//! Modulos gerados por `tools/idlgen` — nao editar.", ""]
    for m in mods:
        lines.append(f"pub mod {m};")
    (gen_dir / "mod.rs").write_text("\n".join(lines) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
