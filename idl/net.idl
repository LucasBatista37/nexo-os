# nexo.net — interface de rede (services/netdev): quadros Ethernet crus.
# Erros remotos: 1 = pedido invalido, 2 = dispositivo nao respondeu.
protocol net 1.1

# Endereco MAC da interface.
method 1 mac {
    request {
    }
    response {
        addr: bytes<6>,
    }
}

# Transmite um quadro Ethernet (14..=1514 bytes).
method 2 send {
    request {
        frame: bytes<1514>,
    }
    response {
    }
}

# Le um quadro recebido, se houver (sem bloquear; resposta vazia = nada).
method 3 recv {
    request {
    }
    response {
        frame: bytes<1514>,
    }
}

# Assina o modo de eventos: a partir dai o driver envia cada quadro recebido como um
# evento `frame` (sem resposta), em vez de guarda-lo para `recv`.
method 4 subscribe {
    request {
    }
    response {
    }
}

# Evento: um quadro Ethernet recebido (so apos `subscribe`).
event 5 frame {
    frame: bytes<1514>,
}
