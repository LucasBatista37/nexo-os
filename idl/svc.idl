# nexo.svc — bring-up tipado (svcmgr/echo/echo-client), Fase 2 revisitada: a limitacao
# "canais do bring-up com mensagens cruas" anunciada na release 0.2 fecha aqui.
# Erros remotos: 1 = pedido invalido; 2 = tente de novo (servico reiniciando).
protocol svc 1.1

# svcmgr -> servico: entrega a ponta de um canal de cliente. Sem resposta por desenho:
# o svcmgr nao bloqueia no servico (que pode cair a qualquer momento).
method 1 serve {
    request {
        chan: handle,
    }
    response {
    }
}

# cliente -> svcmgr: pede uma conexao nova; a resposta traz a ponta do canal com o servico.
method 2 connect {
    request {
    }
    response {
        chan: handle,
    }
}

# cliente -> servico de eco.
method 3 echo {
    request {
        text: bytes<64>,
    }
    response {
        text: bytes<96>,
    }
}

# servico -> svcmgr: "estou pronto para atender". O gerenciador so inicia quem DEPENDE deste
# servico depois deste aviso — a ordem de partida sai da tabela declarada, e a prontidao de
# quem foi iniciado, nao de um sleep esperancoso no gerenciador.
method 4 ready {
    request {
    }
    response {
    }
}
