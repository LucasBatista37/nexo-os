# nexo.sock — API de sockets nativa do servico de rede residente (services/netd).
# v1.2: sockets UDP (por porta) e conexoes TCP (por `conn`) pertencem a sessao que os criou;
# usados por outra sessao devolvem erro 7, e fecham quando a sessao fecha. Ate a v1.1 eram
# globais entre sessoes — o firewall de uma sessao restrita valia na abertura e em mais nada.
# Erros remotos: 1 = pedido invalido, 2 = sem recursos, 3 = tempo esgotado,
# 4 = conexao fechada/reiniciada, 5 = nome nao resolvido, 6 = nao conectado.
protocol sock 1.2

# Configuracao de rede corrente (obtida por DHCP no arranque do netd).
method 1 info {
    request {
    }
    response {
        ip: bytes<4>,
        mask: bytes<4>,
        gateway: bytes<4>,
        dns: bytes<4>,
        mac: bytes<6>,
    }
}

# Resolve um nome (A) usando o DNS do lease, com cache no netd.
method 2 resolve {
    request {
        name: bytes<253>,
    }
    response {
        addr: bytes<4>,
        cached: u8,
    }
}

# Envia um datagrama UDP de `src_port` para `dst`.
method 3 udp_send {
    request {
        dst_ip: bytes<4>,
        dst_port: u16,
        src_port: u16,
        data: bytes<1400>,
    }
    response {
    }
}

# Le um datagrama recebido em `port` (sem bloquear; resposta vazia = nada).
method 4 udp_recv {
    request {
        port: u16,
    }
    response {
        from_ip: bytes<4>,
        from_port: u16,
        data: bytes<1400>,
    }
}

# Abre uma conexao TCP (bloqueia ate ESTABLISHED ou erro 3/4).
method 5 tcp_connect {
    request {
        dst_ip: bytes<4>,
        dst_port: u16,
    }
    response {
        conn: u32,
    }
}

# Envia dados pela conexao.
method 6 tcp_send {
    request {
        conn: u32,
        data: bytes<1400>,
    }
    response {
        sent: u32,
    }
}

# Le o que houver recebido na conexao (sem bloquear; vazio = nada ainda).
method 7 tcp_recv {
    request {
        conn: u32,
    }
    response {
        data: bytes<1400>,
        closed: u8,
    }
}

# Escuta em `port` e bloqueia ate aceitar uma conexao de entrada (erro 3 = tempo esgotado).
method 9 tcp_listen {
    request {
        port: u16,
    }
    response {
        conn: u32,
        peer_ip: bytes<4>,
        peer_port: u16,
    }
}

# Sonda a porta UDP local SEM consumir: quantos datagramas esperam na fila.
# Com tcp_avail, completa a base do poll/select da camada POSIX (ADR-0014).
method 12 udp_avail {
    request {
        port: u16,
    }
    response {
        queued: u32,
    }
}

# Sonda a conexao SEM consumir: bytes prontos para leitura e se o outro lado fechou.
# E a base do poll/select da camada POSIX (ADR-0014).
method 10 tcp_avail {
    request {
        conn: u32,
    }
    response {
        avail: u32,
        closed: u8,
    }
}

# Encerra a conexao (FIN; erro 4 se ja reiniciada).
method 8 tcp_close {
    request {
        conn: u32,
    }
    response {
    }
}

# Abre uma sessao adicional com um PERFIL de rede (firewall): o handle `chan` (ponta de um canal
# criado pelo cliente) passa a ser atendido como novo cliente, restrito a uma regra de destino
# (`rule_*`: sub-rede/porta/protocolo) e as permissoes `allow_dns`/`allow_listen`. O pai, ja
# privilegiado, restringe o filho; modelo negar-por-padrao. rule_protos: bit0 TCP, bit1 UDP,
# bit2 ICMP (ping; v1.1).
method 11 open {
    request {
        chan: handle,
        allow_dns: u8,
        allow_listen: u8,
        rule_ip: bytes<4>,
        rule_prefix: u8,
        rule_port_lo: u16,
        rule_port_hi: u16,
        rule_protos: u8,
    }
    response {
    }
}

# v1.1 — diagnostico de dentro do sistema.

# Ping: um ICMP echo request a `dst_ip` e espera pelo reply ate `timeout_ms`. Passa pelo
# firewall da sessao (bit2 ICMP da regra; erro 7 se negado). Erro 3 = sem resposta no prazo.
# `rtt_us` e medido no netd (entre a entrega ao driver e a chegada do reply), nao no cliente.
method 13 ping {
    request {
        dst_ip: bytes<4>,
        seq: u16,
        timeout_ms: u32,
    }
    response {
        rtt_us: u32,
        ttl: u8,
    }
}

# Estatisticas do netd desde o arranque: quadros recebidos/enviados pelo driver, datagramas
# UDP descartados por fila cheia, sockets UDP e conexoes TCP em uso, entradas no cache DNS,
# pings enviados e respondidos. Contadores globais (nao por socket): sao o que existe.
method 14 stats {
    request {
    }
    response {
        rx_frames: u32,
        tx_frames: u32,
        udp_dropped: u32,
        udp_socks: u32,
        tcp_conns: u32,
        dns_entries: u32,
        pings_sent: u32,
        pings_replied: u32,
    }
}
