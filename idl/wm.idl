# nexo.wm — compositor de janelas (services/wm). Ha 2 displays emulados (0 = primario,
# apresentado no framebuffer real quando ha concessao de video); `display` ausente = 0.
# Fluxo: create_surface -> (o cliente escreve pixels no MemoryObject devolvido) -> commit.
# O wm compoe todas as superficies (de todas as sessoes) na saida (outro MemoryObject) por z.
# Varias sessoes/clientes coexistem: cada um abre uma sessao com `open`, transferindo a ponta
# de um canal novo. Erros remotos: 1 = pedido invalido, 2 = sem recursos, 3 = superficie
# inexistente ou de outra sessao, 4 = limite de sessoes, 5 = captura em vigor por outra
# superficie, 6 = sessao nao detem a entrada (clipboard exige a janela focada/capturada),
# 7 = operacao privilegiada do shell (so a sessao bootstrap, entregue pelo kernel, pode usa-la).
protocol wm 1.20

# Cria uma superficie WxH (RGBX8888) numa posicao (x,y) com z; devolve o id e um handle do
# MemoryObject com os pixels (stride = w).
method 1 create_surface {
    request {
        x: i32,
        y: i32,
        w: i32,
        h: i32,
        z: i32,
        display: u8,
    }
    response {
        id: u32,
        mem: handle,
    }
}

# Marca a superficie `id` como suja (o cliente ja escreveu no buffer); o wm recompoe.
method 2 commit {
    request {
        id: u32,
    }
    response {
    }
}

# Move a superficie `id` para (x,y) (recompoe as regioes afetadas).
method 3 move {
    request {
        id: u32,
        x: i32,
        y: i32,
    }
    response {
    }
}

# Destroi a superficie `id`.
method 4 destroy {
    request {
        id: u32,
    }
    response {
    }
}

# Handle do MemoryObject da saida composta (para o teste/servidor de video inspecionar).
# PRIVILEGIO DO SHELL (sessao 0; erro 7 para as demais): a saida composta e a tela inteira.
method 5 output {
    request {
        display: u8,
    }
    response {
        w: i32,
        h: i32,
        mem: handle,
    }
}

# Move a superficie `id` para outro display; recompoe os dois. Erro 1 se o display nao existe.
method 18 move_to_display {
    request {
        id: u32,
        display: u8,
    }
    response {
    }
}

# Abre mais uma sessao de cliente: transfere a ponta de um canal novo (`chan`); o wm passa a
# atende-la como mais um cliente. As superficies pertencem a sessao que as criou.
method 6 open {
    request {
        chan: handle,
    }
    response {
    }
}

# Traz a superficie `id` para a frente (z acima de todas); recompoe.
method 7 raise {
    request {
        id: u32,
    }
    response {
    }
}

# Envia a superficie `id` para tras (z abaixo de todas); recompoe.
method 8 lower {
    request {
        id: u32,
    }
    response {
    }
}

# Redimensiona a superficie `id` para WxH: realoca o MemoryObject (o antigo e desmapeado) e
# devolve um novo handle com os pixels (o cliente deve remapear). O conteudo anterior e perdido.
method 9 resize {
    request {
        id: u32,
        w: i32,
        h: i32,
    }
    response {
        mem: handle,
    }
}

# Registra a fonte de entrada (mouse/teclado): transfere a ponta de leitura de um canal por onde
# chegam eventos evdev crus (8 bytes cada: [type u16][code u16][value u32]). Em producao o servico
# de entrada alimenta esse canal; o wm move o ponteiro (EV_ABS) e, no clique (BTN_LEFT), traz para
# a frente a superficie sob o ponteiro (foco por clique).
method 10 set_input {
    request {
        chan: handle,
    }
    response {
    }
}

# Maximiza a superficie `id`: move para (0,0) e redimensiona para a saida inteira; guarda o
# retangulo anterior para o `restore`. Realoca o buffer (novo handle; o conteudo antigo e perdido).
method 13 maximize {
    request {
        id: u32,
    }
    response {
        mem: handle,
    }
}

# Restaura a superficie `id` ao retangulo anterior a maximizacao. Realoca o buffer (novo handle).
method 14 restore {
    request {
        id: u32,
    }
    response {
        mem: handle,
    }
}

# Mosaico: organiza TODAS as superficies (de todas as sessoes) numa grade que cobre a saida.
# Nao realoca buffer nenhum: so muda os retangulos de exibicao — o conteudo e escalado na
# composicao (vizinho mais proximo). Gesto global de layout; qualquer sessao pode pedir.
method 15 tile {
    request {
    }
    response {
    }
}

# Captura segura de entrada: enquanto a superficie `id` detem a captura, TODO o teclado vai para
# ela (ignorando o foco) e cliques sao engolidos (nenhuma janela e trazida a frente/focada) — para
# entrada sensivel (ex.: senha) sem roubo de foco. So a sessao dona pode capturar/soltar; uma
# captura por vez; solta sozinha se a superficie e destruida ou a sessao desconecta.
method 16 grab {
    request {
        id: u32,
    }
    response {
    }
}

# Solta a captura da superficie `id` (erro 1 se ela nao detem a captura).
method 17 ungrab {
    request {
        id: u32,
    }
    response {
    }
}

# Contextos (prototipo do modelo do plano): grupos de janelas. So as janelas do contexto ATIVO
# sao compostas e recebem cliques/atalhos; as dos outros ficam ocultas com o estado preservado
# (buffers intactos). Superficies nascem no contexto 0. Ha 4 contextos (0..3).
method 19 set_context {
    request {
        id: u32,
        context: u8,
    }
    response {
    }
}

# Ativa o contexto `context` (erro 1 se nao existe): recompoe mostrando so as janelas dele e move
# o foco para a janela de maior z do contexto (ou nenhuma). A captura (grab) sobrevive a troca —
# uma tela segura nao pode ser contornada trocando de contexto.
method 20 switch_context {
    request {
        context: u8,
    }
    response {
    }
}

# Area de transferencia MEDIADA pelo compositor: so a sessao dona da ENTRADA (a janela focada,
# ou a capturada se ha grab) pode escrever/ler — aplicativos em segundo plano nao farejam nem
# injetam conteudo (erro 6). Ate 256 bytes nesta versao.
method 21 clipboard_set {
    request {
        data: bytes<256>,
    }
    response {
    }
}

method 22 clipboard_get {
    request {
    }
    response {
        data: bytes<256>,
    }
}

# Liga o historico do clipboard (OPT-IN; desligado por padrao). Mesma mediacao do clipboard.
# Depois de ligado, cada clipboard_set tambem entra no anel de historico (4 entradas).
method 23 clipboard_enable_history {
    request {
    }
    response {
    }
}

# Le a entrada `index` do historico (0 = mais recente; erro 1 se nao existe). Mesma mediacao.
method 24 clipboard_history {
    request {
        index: u32,
    }
    response {
        data: bytes<256>,
    }
}

# Notificacoes: qualquer sessao (inclusive em segundo plano) publica um aviso; o compositor
# desenha um banner de sobreposicao no topo direito do display 0 (acima de tudo, em qualquer
# contexto). Com o nao-perturbe ativo, o aviso e descartado (fila/central ficam para o shell).
method 25 notify {
    request {
        title: bytes<64>,
    }
    response {
    }
}

# Remove o banner atual (se houver).
method 26 dismiss_notification {
    request {
    }
    response {
    }
}

# Controle de atencao: liga/desliga o nao-perturbe. Mediado pela posse da entrada (erro 6) — so
# o app com que o usuario interage muda o modo de atencao.
method 27 set_dnd {
    request {
        enabled: u8,
    }
    response {
    }
}

# Define a opacidade da superficie `id` (255 = opaca, 0 = invisivel); recompoe. As superficies
# nascem opacas. Buffers sao *x8888 (sem alfa por pixel), entao a opacidade e da janela inteira.
method 12 set_alpha {
    request {
        id: u32,
        alpha: u8,
    }
    response {
    }
}

# Drag-and-drop por GRANT: a sessao dona da entrada inicia o arrasto com os dados (erro 6 para
# as demais); quando o usuario SOLTA (BTN_LEFT release) sobre uma janela do contexto ativo, so a
# sessao dona dessa janela recebe os dados (evento `drop`) — ninguem mais pode le-los. Soltar no
# vazio (ou durante uma captura) descarta o payload.
method 28 drag_start {
    request {
        data: bytes<256>,
    }
    response {
    }
}

# Evento: clique (BTN_LEFT press) dentro da janela `surface`, em coordenadas LOCAIS da janela.
# Entregue a sessao dona apos o foco/frente. Durante uma captura (grab), cliques continuam
# engolidos (nenhum evento sai).
event 40 pointer {
    surface: u32,
    x: i32,
    y: i32,
}

# Evento: dados soltos sobre a janela `surface` (entregue a sessao dona dela).
event 29 drop {
    surface: u32,
    data: bytes<256>,
}

# Enumeracao de janelas (privilegio do SHELL — a sessao bootstrap; erro 7 para as demais): devolve
# o slot `index` (0..7). `used` = 0 significa slot vazio (os demais campos sao zero). Base da
# Faixa de Atividades.
method 33 surface_info {
    request {
        index: u32,
    }
    response {
        used: u8,
        id: u32,
        context: u8,
        display: u8,
        title: bytes<32>,
    }
}

# Ativa a janela `id` (privilegio do SHELL): troca para o contexto dela se preciso, traz para a
# frente e da o foco (com evento a11y). E o clique na Faixa de Atividades.
method 34 activate {
    request {
        id: u32,
    }
    response {
    }
}

# Escala fracionaria por janela: o retangulo de exibicao vira buffer*num/den (a composicao escala
# por vizinho mais proximo; o buffer nao muda). Ex.: 150%% = 3/2. Erro 1 se num/den invalidos ou o
# resultado nao cabe na saida. So a sessao dona (erro 3).
method 35 set_scale {
    request {
        id: u32,
        num: u32,
        den: u32,
    }
    response {
    }
}

# Preferencia de acessibilidade: reducao de movimento (apps devem desligar animacoes). Mudar
# exige a posse da entrada (erro 6); ler e livre (nao e sensivel).
method 36 set_reduce_motion {
    request {
        enabled: u8,
    }
    response {
    }
}

method 37 prefs {
    request {
    }
    response {
        reduce_motion: u8,
        scale_num: u32,
        scale_den: u32,
        theme: u8,
    }
}

# Tema do sistema (0 = escuro, 1 = claro): preferencia lida em `prefs`; apps repintam a partir
# do Theme correspondente. Mudar exige a posse da entrada (erro 6), como reduce_motion (v1.20).
method 43 set_theme {
    request {
        theme: u8,
    }
    response {
    }
}

# Mosaico continuo (so o shell): com o modo ligado, criar/fechar/desconectar janelas
# refaz o mosaico sozinho — o layout automatico do item "janelas e mosaico" da Fase 5.
method 42 set_auto_tile {
    request {
        enabled: u8,
    }
    response {
    }
}

# Escala global padrao do sistema (so o shell, sessao bootstrap; erro 7): todas as janelas
# passam a ser exibidas em buf*num/den (uma escala por janela via set_scale SOBREPOE a global).
# Apps leem o par em `prefs` para dimensionar texto/UI (o "DPI" do sistema).
method 41 set_global_scale {
    request {
        num: u32,
        den: u32,
    }
    response {
    }
}

# Central de Acoes (mecanismo): o compositor guarda as 8 notificacoes mais recentes — INCLUSIVE
# as suprimidas pelo nao-perturbe (o DND corta a interrupcao; a Central preserva o registro). O
# shell (sessao bootstrap; erro 7) lista por indice (0 = mais recente; used = 0 = vazio) e limpa.
method 38 notification_info {
    request {
        index: u32,
    }
    response {
        used: u8,
        title: bytes<64>,
    }
}

method 39 notifications_clear {
    request {
    }
    response {
    }
}

# Titulo da janela (mostrado por leitores de tela e, futuramente, pela Faixa de Atividades).
method 30 set_title {
    request {
        id: u32,
        title: bytes<32>,
    }
    response {
    }
}

# Acessibilidade: assina o fluxo de EVENTOS SEMANTICOS do compositor (a arquitetura do leitor de
# tela): transfere a ponta de um canal e o compositor passa a emitir eventos `a11y` nela —
# kind 1 = foco mudou (surface + titulo), 2 = aviso publicado (texto), 3 = contexto trocado
# (surface = numero do contexto). Um assinante por vez (o novo substitui o anterior).
method 31 a11y_subscribe {
    request {
        chan: handle,
    }
    response {
    }
}

# Evento semantico de acessibilidade (ver a11y_subscribe).
event 32 a11y {
    kind: u32,
    surface: u32,
    text: bytes<32>,
}

# Evento: uma tecla (EV_KEY que nao seja BTN_LEFT) entregue a janela em foco. `surface` = id da
# superficie focada; `code` = codigo evdev da tecla; `value` = 1 (press) ou 0 (release).
event 11 key {
    surface: u32,
    code: u32,
    value: u32,
}
