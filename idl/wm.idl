# nexo.wm — compositor de janelas (services/wm). Ha 2 displays emulados (0 = primario,
# apresentado no framebuffer real quando ha concessao de video); `display` ausente = 0.
# Fluxo: create_surface -> (o cliente escreve pixels no MemoryObject devolvido) -> commit.
# O wm compoe todas as superficies (de todas as sessoes) na saida (outro MemoryObject) por z.
# Varias sessoes/clientes coexistem: cada um abre uma sessao com `open`, transferindo a ponta
# de um canal novo. Erros remotos: 1 = pedido invalido, 2 = sem recursos, 3 = superficie
# inexistente ou de outra sessao, 4 = limite de sessoes, 5 = captura em vigor por outra superficie.
protocol wm 1.11

# Cria uma superficie WxH (RGBX8888) numa posicao (x,y) com z; devolve o id e um handle do
# MemoryObject com os pixels (stride = w).
method 1 create_surface {
    request {
        x: i32,
        y: i32,
        w: i32,
        h: i32,
        z: i32,
        display: u8,
    }
    response {
        id: u32,
        mem: handle,
    }
}

# Marca a superficie `id` como suja (o cliente ja escreveu no buffer); o wm recompoe.
method 2 commit {
    request {
        id: u32,
    }
    response {
    }
}

# Move a superficie `id` para (x,y) (recompoe as regioes afetadas).
method 3 move {
    request {
        id: u32,
        x: i32,
        y: i32,
    }
    response {
    }
}

# Destroi a superficie `id`.
method 4 destroy {
    request {
        id: u32,
    }
    response {
    }
}

# Handle do MemoryObject da saida composta (para o teste/servidor de video inspecionar).
method 5 output {
    request {
        display: u8,
    }
    response {
        w: i32,
        h: i32,
        mem: handle,
    }
}

# Move a superficie `id` para outro display; recompoe os dois. Erro 1 se o display nao existe.
method 18 move_to_display {
    request {
        id: u32,
        display: u8,
    }
    response {
    }
}

# Abre mais uma sessao de cliente: transfere a ponta de um canal novo (`chan`); o wm passa a
# atende-la como mais um cliente. As superficies pertencem a sessao que as criou.
method 6 open {
    request {
        chan: handle,
    }
    response {
    }
}

# Traz a superficie `id` para a frente (z acima de todas); recompoe.
method 7 raise {
    request {
        id: u32,
    }
    response {
    }
}

# Envia a superficie `id` para tras (z abaixo de todas); recompoe.
method 8 lower {
    request {
        id: u32,
    }
    response {
    }
}

# Redimensiona a superficie `id` para WxH: realoca o MemoryObject (o antigo e desmapeado) e
# devolve um novo handle com os pixels (o cliente deve remapear). O conteudo anterior e perdido.
method 9 resize {
    request {
        id: u32,
        w: i32,
        h: i32,
    }
    response {
        mem: handle,
    }
}

# Registra a fonte de entrada (mouse/teclado): transfere a ponta de leitura de um canal por onde
# chegam eventos evdev crus (8 bytes cada: [type u16][code u16][value u32]). Em producao o servico
# de entrada alimenta esse canal; o wm move o ponteiro (EV_ABS) e, no clique (BTN_LEFT), traz para
# a frente a superficie sob o ponteiro (foco por clique).
method 10 set_input {
    request {
        chan: handle,
    }
    response {
    }
}

# Maximiza a superficie `id`: move para (0,0) e redimensiona para a saida inteira; guarda o
# retangulo anterior para o `restore`. Realoca o buffer (novo handle; o conteudo antigo e perdido).
method 13 maximize {
    request {
        id: u32,
    }
    response {
        mem: handle,
    }
}

# Restaura a superficie `id` ao retangulo anterior a maximizacao. Realoca o buffer (novo handle).
method 14 restore {
    request {
        id: u32,
    }
    response {
        mem: handle,
    }
}

# Mosaico: organiza TODAS as superficies (de todas as sessoes) numa grade que cobre a saida.
# Nao realoca buffer nenhum: so muda os retangulos de exibicao — o conteudo e escalado na
# composicao (vizinho mais proximo). Gesto global de layout; qualquer sessao pode pedir.
method 15 tile {
    request {
    }
    response {
    }
}

# Captura segura de entrada: enquanto a superficie `id` detem a captura, TODO o teclado vai para
# ela (ignorando o foco) e cliques sao engolidos (nenhuma janela e trazida a frente/focada) — para
# entrada sensivel (ex.: senha) sem roubo de foco. So a sessao dona pode capturar/soltar; uma
# captura por vez; solta sozinha se a superficie e destruida ou a sessao desconecta.
method 16 grab {
    request {
        id: u32,
    }
    response {
    }
}

# Solta a captura da superficie `id` (erro 1 se ela nao detem a captura).
method 17 ungrab {
    request {
        id: u32,
    }
    response {
    }
}

# Contextos (prototipo do modelo do plano): grupos de janelas. So as janelas do contexto ATIVO
# sao compostas e recebem cliques/atalhos; as dos outros ficam ocultas com o estado preservado
# (buffers intactos). Superficies nascem no contexto 0. Ha 4 contextos (0..3).
method 19 set_context {
    request {
        id: u32,
        context: u8,
    }
    response {
    }
}

# Ativa o contexto `context` (erro 1 se nao existe): recompoe mostrando so as janelas dele e move
# o foco para a janela de maior z do contexto (ou nenhuma). A captura (grab) sobrevive a troca —
# uma tela segura nao pode ser contornada trocando de contexto.
method 20 switch_context {
    request {
        context: u8,
    }
    response {
    }
}

# Define a opacidade da superficie `id` (255 = opaca, 0 = invisivel); recompoe. As superficies
# nascem opacas. Buffers sao *x8888 (sem alfa por pixel), entao a opacidade e da janela inteira.
method 12 set_alpha {
    request {
        id: u32,
        alpha: u8,
    }
    response {
    }
}

# Evento: uma tecla (EV_KEY que nao seja BTN_LEFT) entregue a janela em foco. `surface` = id da
# superficie focada; `code` = codigo evdev da tecla; `value` = 1 (press) ou 0 (release).
event 11 key {
    surface: u32,
    code: u32,
    value: u32,
}
