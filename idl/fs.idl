# nexo.fs — sistema de arquivos (services/fs e services/vfs)
# Erros remotos: 1..=11 = nexofs::FsError::code(); 13 = montagem somente leitura (vfs /boot).
protocol fs 1.3

# Metadados de um caminho.
method 1 stat {
    request {
        path: bytes<256>,
    }
    response {
        ino: u32,
        kind: u8,
        size: u64,
    }
}

# Cria um arquivo.
method 2 create {
    request {
        path: bytes<256>,
    }
    response {
        ino: u32,
    }
}

# Cria um diretorio.
method 3 mkdir {
    request {
        path: bytes<256>,
    }
    response {
        ino: u32,
    }
}

# Remove um arquivo ou diretorio vazio.
method 4 unlink {
    request {
        path: bytes<256>,
    }
    response {
    }
}

# Le `len` bytes de `ino` a partir de `offset`.
method 5 read {
    request {
        ino: u32,
        offset: u64,
        len: u32,
    }
    response {
        data: bytes<4000>,
    }
}

# Escreve em `ino` a partir de `offset`.
method 6 write {
    request {
        ino: u32,
        offset: u64,
        data: bytes<3900>,
    }
    response {
        written: u32,
    }
}

# Lista um diretorio; entradas concatenadas [ino u32][kind u8][len u8][nome].
method 7 list {
    request {
        path: bytes<256>,
    }
    response {
        count: u32,
        entries: bytes<3900>,
    }
}

# Forca a durabilidade.
method 8 sync {
    request {
    }
    response {
    }
}

# Estatisticas do volume.
method 9 info {
    request {
    }
    response {
        total_blocks: u64,
        free_blocks: u64,
        repairs: u64,
        generation: u64,
    }
}

# Renomeia/move `from` para `to` (mesmo volume; destino nao pode existir). O commit e a
# entrada nova: um corte deixa o arquivo com um ou dois nomes, nunca com zero (v1.1).
method 11 rename {
    request {
        from: bytes<256>,
        to: bytes<256>,
    }
    response {
    }
}

# Trunca `ino` para `size` bytes (so encolhe).
method 10 truncate {
    request {
        ino: u32,
        size: u64,
    }
    response {
    }
}

# Entrega o conteudo de `ino` como um OBJETO DE MEMORIA, em vez de fatias de 4000 bytes.
#
# Nao e um mmap: nao ha paginacao por demanda nem escrita de volta — e uma copia do conteudo
# no instante do pedido, que o cliente mapeia e le direto. Serve a quem precisa do arquivo
# inteiro (uma imagem, um binario) sem o vaivem de uma mensagem por fatia.
#
# Limite: MEMORY_MAX_PAGES (1 MiB). Arquivo maior devolve erro 7 e o cliente usa `read`.
# Erros remotos: 1 pedido invalido, 3 nao encontrado, 7 grande demais, 12 sem memoria.
method 12 map {
    request {
        ino: u32,
    }
    response {
        mem: handle,
        len: u64,
    }
}

# Verifica o volume SEM O ALTERAR e devolve o que encontrou. A montagem ja repara o que ve, e
# cala-se sobre o que era; isto diz O QUE esta errado, que e o que se quer antes de decidir se
# se confia no disco. Tudo zero = integro.
method 13 check {
    request {
    }
    response {
        inodes: u32,
        blocos: u32,
        penduradas: u32,
        duplicadas: u32,
        orfaos: u32,
        blocos_duplicados: u32,
        fora_da_faixa: u32,
        bitmap: u32,
    }
}
